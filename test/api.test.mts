import { describe, expect, it } from "vitest";

import { verifyAddress, importSigningKey } from "../src/address.mts";
import { handleApi, serviceFromDescription } from "../src/api.mts";

const FORWARDING = "example.com=inbox@example.net, Example.org=other@example.net";

function generateSecret(): string {
  return btoa(String.fromCharCode(...crypto.getRandomValues(new Uint8Array(32))));
}

function bitwardenRequest(body: string, host = "email-alias-api.example.com"): Request {
  return new Request(`https://${host}/api/v1/aliases`, {
    method: "POST",
    headers: {
      Authorization: "Bearer token",
      "Content-Type": "application/json",
      Accept: "application/json",
    },
    body,
  });
}

function aliasRequest(
  domain: string,
  description: string,
  host = "email-alias-api.example.com",
): Request {
  return bitwardenRequest(JSON.stringify({ domain, description }), host);
}

describe("handleApi", () => {
  it("returns a signed alias in the addy.io shape", async () => {
    const secret = generateSecret();
    const response = await handleApi(
      aliasRequest("example.com", "Website: www.amazon.co.jp. Generated by Bitwarden."),
      { signingKey: secret, forwarding: FORWARDING },
    );

    expect(response.status).toBe(201);
    const { data } = await response.json<{ data: { email: string } }>();
    expect(data.email).toMatch(/^amazon\.[a-z0-9]{4}\.[a-z0-9]{8}@example\.com$/);
    expect(await verifyAddress(data.email, await importSigningKey(secret))).toBe(true);
  });

  it("accepts the domain of its own hostname regardless of case and spacing", async () => {
    const request = aliasRequest(
      " EXAMPLE.ORG ",
      "Generated by Bitwarden.",
      "email-alias-api.example.org",
    );
    const response = await handleApi(request, {
      signingKey: generateSecret(),
      forwarding: FORWARDING,
    });

    expect(response.status).toBe(201);
    const { data } = await response.json<{ data: { email: string } }>();
    expect(data.email).toMatch(/^mail\..+@example\.org$/);
  });

  it("refuses another alias domain than the one its hostname belongs to", async () => {
    const response = await handleApi(aliasRequest("example.org", "Generated by Bitwarden."), {
      signingKey: generateSecret(),
      forwarding: FORWARDING,
    });

    expect(response.status).toBe(403);
    expect(await response.json()).toEqual({ message: "Unknown domain" });
  });

  it("refuses a parent domain on the hostname of a listed subdomain", async () => {
    const request = aliasRequest(
      "example.com",
      "Generated by Bitwarden.",
      "email-alias-api.mail.example.com",
    );
    const response = await handleApi(request, {
      signingKey: generateSecret(),
      forwarding: "example.com=inbox@example.net,mail.example.com=other@example.net",
    });

    expect(response.status).toBe(403);
  });

  it("refuses a domain outside FORWARD_TO, even on a hostname inside it", async () => {
    const request = aliasRequest(
      "example.edu",
      "Generated by Bitwarden.",
      "email-alias-api.example.edu",
    );
    const response = await handleApi(request, {
      signingKey: generateSecret(),
      forwarding: FORWARDING,
    });

    expect(response.status).toBe(403);
    expect(await response.json()).toEqual({ message: "Unknown domain" });
  });

  it.each([
    ["not JSON", "{"],
    ["no domain", JSON.stringify({ description: "Generated by Bitwarden." })],
    ["a non-object", JSON.stringify("example.com")],
  ])("rejects a body with %s", async (_case, body) => {
    const response = await handleApi(bitwardenRequest(body), {
      signingKey: generateSecret(),
      forwarding: FORWARDING,
    });

    expect(response.status).toBe(400);
    expect(await response.json()).toEqual({ message: "Invalid request" });
  });

  it.each([
    [
      "another path",
      new Request("https://email-alias-api.example.com/api/v1/other", { method: "POST" }),
    ],
    ["another method", new Request("https://email-alias-api.example.com/api/v1/aliases")],
  ])("answers 404 to %s", async (_case, request) => {
    const response = await handleApi(request, {
      signingKey: generateSecret(),
      forwarding: FORWARDING,
    });

    expect(response.status).toBe(404);
  });

  it.each([
    ["the signing key is unusable", { signingKey: "", forwarding: FORWARDING }],
    ["FORWARD_TO is empty", { signingKey: generateSecret(), forwarding: " , " }],
  ])("throws when %s", async (_case, settings) => {
    await expect(handleApi(aliasRequest("example.com", ""), settings)).rejects.toThrow();
  });
});

describe("serviceFromDescription", () => {
  // Bitwarden localizes the description; these locales differ in the punctuation around the site.
  it.each([
    ["en", "Website: $WEBSITE$. Generated by Bitwarden.", "Generated by Bitwarden."],
    [
      "ja",
      "ウェブサイト: $WEBSITE$ Bitwarden によって生成されました。",
      "Bitwarden によって生成されました。",
    ],
    ["zh_CN", "网站：$WEBSITE$。由 Bitwarden 生成。", "由 Bitwarden 生成。"],
    ["ar", "الموقع: $WEBSITE$. تم توليده بواسطة Bitwarden.", "تم إنشاؤه بواسطة Bitwarden."],
  ])("reads the site from the %s description", (_locale, withWebsite, withoutWebsite) => {
    expect(serviceFromDescription(withWebsite.replace("$WEBSITE$", "www.amazon.co.jp"))).toBe(
      "amazon",
    );
    expect(serviceFromDescription(withoutWebsite)).toBe("mail");
  });

  it.each([
    ["accounts.google.com", "google"],
    ["shop.example.com:8443", "example"],
    ["foo.github.io", "github"],
    ["localhost", "mail"],
  ])("maps the site %s to %s", (site, service) => {
    expect(serviceFromDescription(`Website: ${site}. Generated by Bitwarden.`)).toBe(service);
  });

  it("falls back to mail for an empty description", () => {
    expect(serviceFromDescription("")).toBe("mail");
  });

  it("keeps the service within the length an alias can carry", () => {
    const longLabel = "a".repeat(40);
    expect(serviceFromDescription(`Website: www.${longLabel}.com.`)).toBe("a".repeat(32));
  });
});
