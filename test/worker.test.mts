import { createExecutionContext } from "cloudflare:test";
import { env } from "cloudflare:workers";
import { afterAll, beforeAll, describe, expect, it, vi } from "vitest";

import { createAddress, importSigningKey, verifyAddress } from "../src/address.mts";
import worker from "../src/index.mts";
import { createFakeAccess } from "./fake-access.mts";

const IncomingRequest = Request<unknown, IncomingRequestCfProperties>;

const access = await createFakeAccess(env.ACCESS_TEAM_DOMAIN);

beforeAll(() => access.network.enable());
afterAll(() => access.network.disable());

function incomingMail(to: string) {
  const forward = vi.fn(async () => ({ messageId: "forwarded" }));
  const setReject = vi.fn();
  const message: ForwardableEmailMessage = {
    from: "sender@example.org",
    to,
    headers: new Headers(),
    raw: new Blob(["hello"]).stream(),
    rawSize: 5,
    forward,
    setReject,
    reply: vi.fn(async () => ({ messageId: "replied" })),
  };
  return { message, forward, setReject };
}

function aliasRequest(headers: Record<string, string>) {
  return new IncomingRequest("https://alias.example.com/api/v1/aliases", {
    method: "POST",
    headers: { "Content-Type": "application/json", Accept: "application/json", ...headers },
    body: JSON.stringify({
      domain: "example.com",
      description: "Website: www.amazon.co.jp. Generated by Bitwarden.",
    }),
  });
}

describe("worker email entrypoint", () => {
  it("forwards a signed alias to the configured destination", async () => {
    const key = await importSigningKey(env.SIGNING_KEY);
    const to = await createAddress({ service: "shop", domain: "example.com" }, key);
    const { message, forward, setReject } = incomingMail(to);

    await worker.email(message, env, createExecutionContext());

    expect(forward).toHaveBeenCalledWith(env.FORWARD_TO);
    expect(setReject).not.toHaveBeenCalled();
  });

  it("rejects an unsigned address", async () => {
    const { message, forward, setReject } = incomingMail("info@example.com");

    await worker.email(message, env, createExecutionContext());

    expect(setReject).toHaveBeenCalledWith("Unknown address");
    expect(forward).not.toHaveBeenCalled();
  });
});

describe("worker fetch entrypoint", () => {
  it("creates an alias through Access that the email entrypoint then forwards", async () => {
    const token = await access.sign({
      iss: `https://${env.ACCESS_TEAM_DOMAIN}`,
      aud: [env.ACCESS_AUD],
      common_name: env.ACCESS_CLIENT_ID,
    });

    const response = await worker.fetch(
      aliasRequest({ "Cf-Access-Jwt-Assertion": token }),
      env,
      createExecutionContext(),
    );

    expect(response.status).toBe(201);
    const { data } = await response.json<{ data: { email: string } }>();
    expect(await verifyAddress(data.email, await importSigningKey(env.SIGNING_KEY))).toBe(true);

    const { message, forward } = incomingMail(data.email);
    await worker.email(message, env, createExecutionContext());
    expect(forward).toHaveBeenCalledWith(env.FORWARD_TO);
  });

  it("refuses a request that did not come through Access", async () => {
    const response = await worker.fetch(
      aliasRequest({ Authorization: "Bearer token" }),
      env,
      createExecutionContext(),
    );

    expect(response.status).toBe(403);
    expect(await response.json()).toEqual({ message: "Forbidden" });
  });
});
