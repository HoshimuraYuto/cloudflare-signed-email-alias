import { getDomainWithoutSuffix } from "tldts-icann";

import { createAddress, importSigningKey } from "./address.mts";

const ALIASES_PATH = "/api/v1/aliases";
const FALLBACK_SERVICE = "mail";
const MAX_SERVICE_LENGTH = 32;
const HOSTNAME_PATTERN = /[a-z0-9-]+(?:\.[a-z0-9-]+)+/i;

interface ApiSettings {
  signingKey: string;
  /** Comma-separated domains an alias may use. */
  aliasDomains: string;
}

interface CreateAliasRequest {
  domain: string;
  description: string;
}

/**
 * Answers POST /api/v1/aliases the way addy.io does, so Bitwarden can use it as a forwarder.
 * Throws when the settings are unusable.
 */
export async function handleApi(request: Request, settings: ApiSettings): Promise<Response> {
  const url = new URL(request.url);
  if (request.method !== "POST" || url.pathname !== ALIASES_PATH) {
    return new Response(null, { status: 404 });
  }
  const key = await importSigningKey(settings.signingKey);
  const domains = parseDomains(settings.aliasDomains);

  const body = await readBody(request);
  if (body === null) {
    return Response.json({ message: "Invalid request" }, { status: 400 });
  }
  const domain = body.domain.trim().toLowerCase();
  if (!domains.has(domain)) {
    return Response.json({ message: "Unknown domain" }, { status: 403 });
  }
  const service = serviceFromDescription(body.description);
  const email = await createAddress({ service, domain }, key);
  return Response.json({ data: { email } }, { status: 201 });
}

/**
 * Bitwarden sends the site only inside a localized sentence, such as
 * "Website: www.amazon.co.jp. Generated by Bitwarden." → "amazon".
 */
export function serviceFromDescription(description: string): string {
  const hostname = HOSTNAME_PATTERN.exec(description)?.[0] ?? "";
  const label = getDomainWithoutSuffix(hostname) ?? "";
  const service = label
    .toLowerCase()
    .replaceAll(/[^a-z0-9-]/g, "")
    .slice(0, MAX_SERVICE_LENGTH);
  return service === "" ? FALLBACK_SERVICE : service;
}

function parseDomains(aliasDomains: string): Set<string> {
  const domains = new Set(
    aliasDomains
      .split(",")
      .map((domain) => domain.trim().toLowerCase())
      .filter((domain) => domain !== ""),
  );
  if (domains.size === 0) {
    throw new Error("ALIAS_DOMAINS is not set");
  }
  return domains;
}

async function readBody(request: Request): Promise<CreateAliasRequest | null> {
  let body: unknown;
  try {
    body = await request.json();
  } catch {
    return null;
  }
  if (typeof body !== "object" || body === null) {
    return null;
  }
  if (!("domain" in body) || typeof body.domain !== "string") {
    return null;
  }
  const description =
    "description" in body && typeof body.description === "string" ? body.description : "";
  return { domain: body.domain, description };
}
