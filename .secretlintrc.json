{
  "rules": [
    {
      "id": "@secretlint/secretlint-rule-pattern",
      "options": {
        "patterns": [
          {
            "name": "Cloudflare account or zone ID (32 hex characters)",
            "patterns": ["/\\b[0-9a-f]{32}\\b/"]
          },
          {
            "name": "e-mail address outside reserved domains",
            "patterns": [
              "/[\\w.+-]+@(?!(?:[\\w-]+\\.)*example\\.(?:com|net|org)\\b)[\\w-]+(?:\\.[\\w-]+)*\\.[a-z]{2,}\\b/i"
            ]
          }
        ]
      }
    },
    {
      "id": "@secretlint/secretlint-rule-preset-recommend"
    }
  ]
}
