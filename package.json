{
  "name": "cloudflare-signed-email-alias",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "cf workers types && oxfmt --check . && oxlint --type-aware --deny-warnings && tsc && secretlint \"**/*\"",
    "fix": "oxfmt . && oxlint --type-aware --fix",
    "prepare": "lefthook install",
    "types": "cf workers types",
    "build": "cf build"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.3",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/types": "21.2.3",
    "@secretlint/secretlint-rule-pattern": "13.0.7",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.7",
    "cf": "1.0.0-beta.20",
    "lefthook": "2.2.1",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "secretlint": "13.0.7",
    "semantic-release": "25.0.9",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "engines": {
    "node": ">=24.22.0"
  },
  "packageManager": "pnpm@12.14.0"
}
