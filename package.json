{
  "name": "cloudflare-signed-email-alias",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "oxfmt --check . && oxlint --type-aware --deny-warnings && tsc && secretlint \"**/*\"",
    "fix": "oxfmt . && oxlint --type-aware --fix",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/types": "21.2.3",
    "@secretlint/secretlint-rule-pattern": "13.0.7",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.7",
    "lefthook": "2.2.2",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "secretlint": "13.0.7",
    "semantic-release": "25.0.9",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.14.0"
}
